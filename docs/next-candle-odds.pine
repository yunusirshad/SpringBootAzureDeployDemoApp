//@version=6
indicator("Buy / Sell Timing + Breakout Odds", shorttitle = "Timing Odds", overlay = true, max_lines_count = 40, max_boxes_count = 10, max_labels_count = 30, max_bars_back = 500)
// Act now, or wait for a better price? Odds from history, not predictions. Every answer comes with prices.
// The indicator looks at every past candle in the SAME STATE as the last closed candle and measures what price did
// over the next N candles: how far it DIPPED below the close, how far it RALLIED above it, and where it closed.
//   STATE (12 kinds) = momentum (close vs a rising / falling EMA: up, none, down)
//                    x price vs VWAP (intraday) or the 50 EMA (daily and above): above / below
//                    x volume vs its average: high / low
// IF YOU WANT TO BUY
//   WAIT      a dip of at least "Worth waiting" x ATR came first in at least "Wait if" % of past cases:
//             shows the limit BUY PRICE that was reached that often within N candles.
//   BUY NOW   dips were small AND price was higher N candles later at least "Act if" % of the time: BUY PRICE = now.
//   NO EDGE   neither: no reason from the odds to buy now or to wait for a level.
//   Also: the price it stayed ABOVE 8 times out of 10 (a stop reference) and the typical price N candles later.
// IF YOU WANT TO SELL (take profit on a long, or short): the mirror, with rallies instead of dips.
// BREAKOUT PROBABILITY (next candle): the chance the next candle trades above the last candle's HIGH, and above it
//   by +1..+4 steps (x ATR), and the same below its LOW, from past candles in the same state. Each level is drawn with
//   its price and %. ACCURACY CHECK: over all past candles, the average probability given for "breaks the high" vs how
//   often it really happened (same for the low). Close numbers = the % can be trusted.
// BREAKOUT BUY / SELL: when the chance that the next candle breaks the last candle's high is at least "Breakout
//   call" %, the BUY answer becomes BREAKOUT BUY with a buy stop just above that high (SELL: below the low).
//   Otherwise the answer stays BUY NOW / SELL NOW / WAIT (at a price) / NO EDGE.
// TRACK RECORD (out of sample: each call only used the candles before it): how often a WAIT price was reached and
// how often a NOW call was right N candles later. If these are near 50%, ignore the advice.
// It learns bar by bar on the chart's own history; no look-ahead, no repaint on closed candles.

grpM = "Model"
emaLen  = input.int(20, "Momentum EMA length", minval = 2, group = grpM)
volLen  = input.int(20, "Volume average length", minval = 2, group = grpM)
horizon = input.int(5, "Look ahead (candles)", minval = 2, maxval = 50, group = grpM)
dipNeed = input.float(0.25, "Worth waiting for a move of at least (x ATR)", minval = 0.05, step = 0.05, group = grpM)
waitP   = input.float(60, "Wait if that move came first in at least (%)", minval = 50, maxval = 95, group = grpM)
actP    = input.float(55, "Buy / sell now if right N candles later at least (%)", minval = 50, maxval = 95, group = grpM)
memory  = input.int(400, "Outcomes remembered per state", minval = 50, maxval = 2000, group = grpM)
minN    = input.int(30, "Min samples to trust a state", minval = 5, group = grpM)

grpB = "Breakout probability"
showBo  = input.bool(true, "Show breakout probabilities (next candle)", group = grpB)
boStep  = input.float(0.25, "Step between levels (x ATR)", minval = 0.05, step = 0.05, group = grpB)
boLevels = input.int(4, "Levels each side (beyond the high / low)", minval = 1, maxval = 6, group = grpB)
boThr   = input.float(60, "Breakout call: break chance at least (%)", minval = 50, maxval = 95, group = grpB)

grpD = "Display"
showLv  = input.bool(true, "Draw the buy / sell prices on the chart", group = grpD)
showFan = input.bool(false, "Show the N-candle fan", group = grpD)
showTbl = input.bool(true, "Show the table", group = grpD)
showRec = input.bool(false, "Show the track records and accuracy check", group = grpD)
tblPosIn = input.string("Top right", "Table position", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = grpD)
colUp   = input.color(color.new(#089981, 0), "Buy", group = grpD)
colDn   = input.color(color.new(#f23645, 0), "Sell", group = grpD)
colWait = input.color(color.new(#f2c14e, 0), "Wait", group = grpD)
colFan  = input.color(color.new(#00bcd4, 0), "Fan", group = grpD)

// ───── State of a candle ─────
atr   = ta.atr(14)
ema   = ta.ema(close, emaLen)
mom   = close > ema and ema >= ema[3] ? 1 : close < ema and ema <= ema[3] ? -1 : 0
ref   = timeframe.isintraday ? ta.vwap(hlc3) : ta.ema(close, 50)
above = close > ref
volHi = volume > ta.sma(volume, volLen)
state = (mom + 1) * 4 + (above ? 2 : 0) + (volHi ? 1 : 0)
lowH  = ta.lowest(low, horizon)       // the lowest low of the last N candles
highH = ta.highest(high, horizon)

stateName(int s) =>
    int m = math.floor(s / 4) - 1
    int rest = s % 4
    string refName = timeframe.isintraday ? "VWAP" : "50 EMA"
    (m > 0 ? "Momentum UP" : m < 0 ? "Momentum DOWN" : "No momentum") + " · " + (rest >= 2 ? "above " : "below ") + refName + " · " + (rest % 2 == 1 ? "volume HIGH" : "volume low")

// ───── Per-state memory of what happened over the next N candles (ATR units) ─────
var matrix<float> mDip = matrix.new<float>(12, memory, na)   // lowest low - close (<= 0)
var matrix<float> mRun = matrix.new<float>(12, memory, na)   // highest high - close (>= 0)
var matrix<float> mRet = matrix.new<float>(12, memory, na)   // close N candles later - close
var array<int>    wIx  = array.new<int>(12, 0)
// next candle: how far its high went above this candle's high, and its low below this candle's low (ATR units)
var matrix<float> mBH = matrix.new<float>(12, memory, na)
var matrix<float> mBL = matrix.new<float>(12, memory, na)
var array<int>    wB  = array.new<int>(12, 0)
var int   bS = na
var float bHi = na
var float bLo = na
var float bAtr = na
var float bPH = na             // probability given at the last close that the next candle breaks the high
var float bPL = na
var float sumPH = 0.0
var int   hitPH = 0
var float sumPL = 0.0
var int   hitPL = 0
var int   nCal = 0
var int   nBoB = 0
var int   hBoB = 0
var int   nBoS = 0
var int   hBoS = 0

// candles waiting N candles for their outcome, with the advice given at their close
var array<int>   qS = array.new<int>()
var array<float> qC = array.new<float>()
var array<float> qA = array.new<float>()
var array<int>   qBuy = array.new<int>()      // 1 buy now, 2 wait for a dip, 0 no edge
var array<float> qBuyLv = array.new<float>()
var array<int>   qSell = array.new<int>()     // 1 sell now, 2 wait for higher, 0 no edge
var array<float> qSellLv = array.new<float>()

var int nBuyNow = 0
var int wBuyNow = 0
var int nWaitDip = 0
var int fWaitDip = 0
var int nSellNow = 0
var int wSellNow = 0
var int nWaitUp = 0
var int fWaitUp = 0

rowVals(matrix<float> m, int s) =>
    vals = array.new<float>()
    for v in m.row(s)
        if not na(v)
            vals.push(v)
    vals

// share of past cases whose value reached at least k
shareAtLeast(matrix<float> m, int s, float k) =>
    int n = 0
    int c = 0
    for v in m.row(s)
        if not na(v)
            n += 1
            c += v >= k ? 1 : 0
    n > 0 ? float(c) / n : na

// the advice for a state, in ATR units from the close:
// [buyType, buy level, pUpN, sellType, sell level, pDownN, n, floor80, ceil80, medianN]
advice(int s) =>
    dips = rowVals(mDip, s)
    runs = rowVals(mRun, s)
    rets = rowVals(mRet, s)
    int n = rets.size()
    int bT = 0
    float bL = na
    int sT = 0
    float sL = na
    float pUp = na
    float pDn = na
    float fl80 = na
    float ce80 = na
    float med = na
    if n >= minN
        int up = 0
        int dn = 0
        for r in rets
            up += r > 0 ? 1 : 0
            dn += r < 0 ? 1 : 0
        pUp := float(up) / n
        pDn := float(dn) / n
        // the dip reached in waitP% of cases, and the rally reached in waitP% of cases
        float dipLv = dips.percentile_linear_interpolation(waitP)
        float runLv = runs.percentile_linear_interpolation(100 - waitP)
        fl80 := dips.percentile_linear_interpolation(20)      // price stayed above this 8 times in 10
        ce80 := runs.percentile_linear_interpolation(80)      // price stayed below this 8 times in 10
        med := rets.percentile_linear_interpolation(50)
        if dipLv <= -dipNeed
            bT := 2, bL := dipLv
        else if pUp * 100 >= actP
            bT := 1
        if runLv >= dipNeed
            sT := 2, sL := runLv
        else if pDn * 100 >= actP
            sT := 1
    [bT, bL, pUp, sT, sL, pDn, n, fl80, ce80, med]

if barstate.isconfirmed and not na(atr) and not na(ema)
    // breakout outcome of this candle vs the previous candle's high / low; accuracy check of what was said
    if not na(bS) and bAtr > 0
        bool hitH = high > bHi
        bool hitL = low < bLo
        if not na(bPH) and not na(bPL)
            sumPH += bPH, hitPH += hitH ? 1 : 0
            sumPL += bPL, hitPL += hitL ? 1 : 0
            nCal += 1
            if bPH * 100 >= boThr
                nBoB += 1, hBoB += hitH ? 1 : 0
            if bPL * 100 >= boThr
                nBoS += 1, hBoS += hitL ? 1 : 0
        int j = wB.get(bS) % memory
        mBH.set(bS, j, (high - bHi) / bAtr)
        mBL.set(bS, j, (bLo - low) / bAtr)
        wB.set(bS, wB.get(bS) + 1)
    bS := state, bHi := high, bLo := low, bAtr := atr
    int nb = math.min(wB.get(state), memory)
    bPH := nb >= minN ? shareAtLeast(mBH, state, 1e-9) : na
    bPL := nb >= minN ? shareAtLeast(mBL, state, 1e-9) : na
    // the advice at this close (from the candles before it)
    [bT, bL, pUp, sT, sL, pDn, n, fl80, ce80, med] = advice(state)
    qS.push(state), qC.push(close), qA.push(atr)
    qBuy.push(bT), qBuyLv.push(na(bL) ? na : close + bL * atr)
    qSell.push(sT), qSellLv.push(na(sL) ? na : close + sL * atr)
    // the candle N candles ago now has its outcome: learn it and score its advice
    if qS.size() > horizon
        int s0 = qS.shift()
        float c0 = qC.shift()
        float a0 = qA.shift()
        int b0 = qBuy.shift()
        float bl0 = qBuyLv.shift()
        int x0 = qSell.shift()
        float xl0 = qSellLv.shift()
        if a0 > 0
            int i = wIx.get(s0) % memory
            mDip.set(s0, i, (lowH - c0) / a0)
            mRun.set(s0, i, (highH - c0) / a0)
            mRet.set(s0, i, (close - c0) / a0)
            wIx.set(s0, wIx.get(s0) + 1)
        if b0 == 1
            nBuyNow += 1
            wBuyNow += close > c0 ? 1 : 0
        if b0 == 2
            nWaitDip += 1
            fWaitDip += lowH <= bl0 ? 1 : 0
        if x0 == 1
            nSellNow += 1
            wSellNow += close < c0 ? 1 : 0
        if x0 == 2
            nWaitUp += 1
            fWaitUp += highH >= xl0 ? 1 : 0

pct(float p) => na(p) ? "—" : str.tostring(p * 100, "#") + "%"
f(float v) => str.tostring(v, format.mintick)
rec(int n, int k, string what) => n == 0 ? "no calls yet" : what + " " + str.tostring(100.0 * k / n, "#") + "% of " + str.tostring(n) + " times"

// ───── Drawing (last bar) ─────
var array<line>     lns = array.new<line>()
var array<label>    lbs = array.new<label>()
var array<linefill> lfs = array.new<linefill>()
pos = tblPosIn == "Bottom right" ? position.bottom_right : tblPosIn == "Top left" ? position.top_left : tblPosIn == "Bottom left" ? position.bottom_left : position.top_right
var table tb = table.new(pos, 2, 12, bgcolor = color.new(#0b0e14, 0), border_width = 1, border_color = color.new(color.gray, 75))

var int lastS = na
var float lastC = na
var float lastA = na
if barstate.isconfirmed
    lastS := state, lastC := close, lastA := atr

int buyCode = na
int sellCode = na
float buyPx = na
float sellPx = na
if barstate.islast and not na(lastS) and not na(lastA)
    for x in lns
        line.delete(x)
    for x in lbs
        label.delete(x)
    for x in lfs
        linefill.delete(x)
    lns.clear(), lbs.clear(), lfs.clear()
    [bT, bL, pUp, sT, sL, pDn, n, fl80, ce80, med] = advice(lastS)
    buyCode := bT
    sellCode := sT
    float base = lastC
    float a = lastA
    int x2 = bar_index + horizon
    string hz = str.tostring(horizon) + " candles"
    // the price to act at: the wait level, or the last close for NOW
    buyPx := bT == 2 ? base + bL * a : bT == 1 ? base : na
    sellPx := sT == 2 ? base + sL * a : sT == 1 ? base : na
    float floorPx = na(fl80) ? na : base + fl80 * a
    float ceilPx = na(ce80) ? na : base + ce80 * a
    float medPx = na(med) ? na : base + med * a
    if showFan
        rets = rowVals(mRet, lastS)
        if rets.size() >= 5
            float h10 = rets.percentile_linear_interpolation(10)
            float h50 = rets.percentile_linear_interpolation(50)
            float h90 = rets.percentile_linear_interpolation(90)
            l10 = line.new(bar_index, base, x2, base + h10 * a, color = color.new(colFan, 40), style = line.style_dotted)
            l50 = line.new(bar_index, base, x2, base + h50 * a, color = color.white, style = line.style_dashed)
            l90 = line.new(bar_index, base, x2, base + h90 * a, color = color.new(colFan, 40), style = line.style_dotted)
            lns.push(l10), lns.push(l50), lns.push(l90)
            lfs.push(linefill.new(l10, l90, color.new(colFan, 90)))

    float pBreakH = na
    float pBreakL = na
    bool boOk = not na(bS) and math.min(wB.get(bS), memory) >= minN
    if boOk
        pBreakH := shareAtLeast(mBH, bS, 1e-9)
        pBreakL := shareAtLeast(mBL, bS, 1e-9)
    bool boBuy = boOk and pBreakH * 100 >= boThr
    bool boSell = boOk and pBreakL * 100 >= boThr
    float tick = syminfo.mintick
    if boBuy
        buyCode := 3
        buyPx := bHi + tick
    if boSell
        sellCode := 3
        sellPx := bLo - tick
    if showLv and boBuy
        lns.push(line.new(bar_index, bHi + tick, x2, bHi + tick, color = colUp, width = 3))
        lbs.push(label.new(x2, bHi + tick, "BREAKOUT BUY " + f(bHi + tick) + "  " + pct(pBreakH), style = label.style_label_left,
             color = colUp, textcolor = color.white, size = size.small, text_formatting = text.format_bold))
    if showLv and boSell
        lns.push(line.new(bar_index, bLo - tick, x2, bLo - tick, color = colDn, width = 3))
        lbs.push(label.new(x2, bLo - tick, "BREAKOUT SELL " + f(bLo - tick) + "  " + pct(pBreakL), style = label.style_label_left,
             color = colDn, textcolor = color.white, size = size.small, text_formatting = text.format_bold))
    if showLv and not na(buyPx) and buyCode != 3
        lns.push(line.new(bar_index, buyPx, x2, buyPx, color = colUp, width = 2, style = bT == 2 ? line.style_dashed : line.style_solid))
        lbs.push(label.new(x2, buyPx, (bT == 2 ? "BUY AT " : "BUY NOW ") + f(buyPx) + "  " + (bT == 2 ? str.tostring(waitP, "#") + "%" : pct(pUp)), style = label.style_label_left,
             color = color.new(#0b0e14, 0), textcolor = colUp, size = size.small, text_formatting = text.format_bold))
    if showLv and not na(sellPx) and sellCode != 3
        lns.push(line.new(bar_index, sellPx, x2, sellPx, color = colDn, width = 2, style = sT == 2 ? line.style_dashed : line.style_solid))
        lbs.push(label.new(x2, sellPx, (sT == 2 ? "SELL AT " : "SELL NOW ") + f(sellPx) + "  " + (sT == 2 ? str.tostring(waitP, "#") + "%" : pct(pDn)), style = label.style_label_left,
             color = color.new(#0b0e14, 0), textcolor = colDn, size = size.small, text_formatting = text.format_bold))
    if showBo and boOk
        int bx = barstate.isconfirmed ? bar_index + 1 : bar_index
        for k = 0 to boLevels
            float stepA = k * boStep
            float pH = shareAtLeast(mBH, bS, k == 0 ? 1e-9 : stepA)
            float pL = shareAtLeast(mBL, bS, k == 0 ? 1e-9 : stepA)
            float pxH = bHi + stepA * bAtr
            float pxL = bLo - stepA * bAtr
            lns.push(line.new(bx - 1, pxH, bx + 2, pxH, color = color.new(colUp, k == 0 ? 0 : 40), width = k == 0 ? 2 : 1))
            lbs.push(label.new(bx + 2, pxH, f(pxH) + "  " + pct(pH), style = label.style_label_left,
                 color = color.new(#0b0e14, 0), textcolor = color.new(colUp, k == 0 ? 0 : 30), size = size.small, text_formatting = text.format_bold))
            lns.push(line.new(bx - 1, pxL, bx + 2, pxL, color = color.new(colDn, k == 0 ? 0 : 40), width = k == 0 ? 2 : 1))
            lbs.push(label.new(bx + 2, pxL, f(pxL) + "  " + pct(pL), style = label.style_label_left,
                 color = color.new(#0b0e14, 0), textcolor = color.new(colDn, k == 0 ? 0 : 30), size = size.small, text_formatting = text.format_bold))

    if showTbl
        bool thin = n < minN
        // the answer, its price, and the one probability behind it
        string buyHead = thin ? "NOT ENOUGH HISTORY" : boBuy ? "BREAKOUT BUY  " + f(bHi + tick) : bT == 2 ? "WAIT — BUY AT " + f(buyPx) : bT == 1 ? "BUY NOW  " + f(buyPx) : "NO EDGE — WAIT"
        string buyProb = thin ? "" : boBuy ? pct(pBreakH) + " chance the next candle breaks above " + f(bHi) : bT == 2 ? str.tostring(waitP, "#") + "% chance price comes down to " + f(buyPx) + " first" : bT == 1 ? pct(pUp) + " chance price is higher in " + hz : pct(pUp) + " chance higher in " + hz
        string sellHead = thin ? "NOT ENOUGH HISTORY" : boSell ? "BREAKOUT SELL  " + f(bLo - tick) : sT == 2 ? "WAIT — SELL AT " + f(sellPx) : sT == 1 ? "SELL NOW  " + f(sellPx) : "NO EDGE — HOLD"
        string sellProb = thin ? "" : boSell ? pct(pBreakL) + " chance the next candle breaks below " + f(bLo) : sT == 2 ? str.tostring(waitP, "#") + "% chance price goes up to " + f(sellPx) + " first" : sT == 1 ? pct(pDn) + " chance price is lower in " + hz : pct(pDn) + " chance lower in " + hz
        color bc = thin ? color.gray : boBuy ? colUp : bT == 2 ? colWait : bT == 1 ? colUp : color.gray
        color sc = thin ? color.gray : boSell ? colDn : sT == 2 ? colWait : sT == 1 ? colDn : color.gray
        table.cell(tb, 0, 0, "NOW", text_color = color.silver, text_size = size.small)
        table.cell(tb, 1, 0, f(base), text_color = color.white, text_size = size.normal, text_formatting = text.format_bold)
        table.cell(tb, 0, 1, "BUY", text_color = color.white, bgcolor = color.new(colUp, 40), text_size = size.small, text_formatting = text.format_bold)
        table.cell(tb, 1, 1, buyHead, text_color = color.white, bgcolor = color.new(bc, 25), text_size = size.normal, text_formatting = text.format_bold)
        table.cell(tb, 0, 2, "", text_size = size.small)
        table.cell(tb, 1, 2, buyProb, text_color = color.white, text_size = size.small, text_formatting = text.format_bold)
        table.cell(tb, 0, 3, "SELL", text_color = color.white, bgcolor = color.new(colDn, 40), text_size = size.small, text_formatting = text.format_bold)
        table.cell(tb, 1, 3, sellHead, text_color = color.white, bgcolor = color.new(sc, 25), text_size = size.normal, text_formatting = text.format_bold)
        table.cell(tb, 0, 4, "", text_size = size.small)
        table.cell(tb, 1, 4, sellProb, text_color = color.white, text_size = size.small, text_formatting = text.format_bold)
        if showBo
            table.cell(tb, 0, 5, "NEXT CANDLE", text_color = color.white, bgcolor = color.new(colWait, 40), text_size = size.small, text_formatting = text.format_bold)
            table.cell(tb, 1, 5, na(pBreakH) ? "not enough history" : "above " + f(bHi) + ": " + pct(pBreakH) + "   ·   below " + f(bLo) + ": " + pct(pBreakL), text_color = color.white, text_size = size.small, text_formatting = text.format_bold)
        if showRec
            table.cell(tb, 0, 6, "Track: BUY NOW", text_color = color.silver, text_size = size.small)
            table.cell(tb, 1, 6, rec(nBuyNow, wBuyNow, "higher " + hz + " later"), text_color = color.white, text_size = size.small)
            table.cell(tb, 0, 7, "Track: BUY AT", text_color = color.silver, text_size = size.small)
            table.cell(tb, 1, 7, rec(nWaitDip, fWaitDip, "price reached"), text_color = color.white, text_size = size.small)
            table.cell(tb, 0, 8, "Track: SELL NOW", text_color = color.silver, text_size = size.small)
            table.cell(tb, 1, 8, rec(nSellNow, wSellNow, "lower " + hz + " later"), text_color = color.white, text_size = size.small)
            table.cell(tb, 0, 9, "Track: SELL AT", text_color = color.silver, text_size = size.small)
            table.cell(tb, 1, 9, rec(nWaitUp, fWaitUp, "price reached"), text_color = color.white, text_size = size.small)
            table.cell(tb, 0, 10, "Track: BREAKOUT", text_color = color.silver, text_size = size.small)
            table.cell(tb, 1, 10, "BUY " + rec(nBoB, hBoB, "broke the high") + "  ·  SELL " + rec(nBoS, hBoS, "broke the low"), text_color = color.white, text_size = size.small)
            table.cell(tb, 0, 11, "Accuracy check", text_color = color.silver, text_size = size.small)
            table.cell(tb, 1, 11, nCal == 0 ? "not enough history" : "breaks high: said " + str.tostring(100 * sumPH / nCal, "#") + "% → happened " + str.tostring(100.0 * hitPH / nCal, "#") + "%  ·  breaks low: said " + str.tostring(100 * sumPL / nCal, "#") + "% → happened " + str.tostring(100.0 * hitPL / nCal, "#") + "%", text_color = color.white, text_size = size.small)

// data window / alerts
plot(nCal > 0 ? 100 * sumPH / nCal : na, "Accuracy: high break said %", display = display.data_window)
plot(nCal > 0 ? 100.0 * hitPH / nCal : na, "Accuracy: high break happened %", display = display.data_window)
plot(nCal > 0 ? 100 * sumPL / nCal : na, "Accuracy: low break said %", display = display.data_window)
plot(nCal > 0 ? 100.0 * hitPL / nCal : na, "Accuracy: low break happened %", display = display.data_window)
plot(bPH * 100, "Next candle breaks the high %", display = display.data_window)
plot(bPL * 100, "Next candle breaks the low %", display = display.data_window)
plot(buyPx, "Buy price (now or wait level)", display = display.data_window)
plot(sellPx, "Sell price (now or wait level)", display = display.data_window)
plot(buyCode, "Buy advice (3 breakout, 1 now, 2 wait, 0 no edge)", display = display.data_window)
plot(sellCode, "Sell advice (3 breakout, 1 now, 2 wait, 0 no edge)", display = display.data_window)
plot(nBoB > 0 ? 100.0 * hBoB / nBoB : na, "Track: BREAKOUT BUY broke the high %", display = display.data_window)
plot(nBoB, "Track: BREAKOUT BUY calls", display = display.data_window)
plot(nBoS > 0 ? 100.0 * hBoS / nBoS : na, "Track: BREAKOUT SELL broke the low %", display = display.data_window)
plot(nBoS, "Track: BREAKOUT SELL calls", display = display.data_window)
alertcondition(not na(bPH) and bPH * 100 >= boThr and barstate.isconfirmed, "BREAKOUT BUY", "{{ticker}} BREAKOUT BUY: the next candle breaks the high in at least the threshold % of past cases")
alertcondition(not na(bPL) and bPL * 100 >= boThr and barstate.isconfirmed, "BREAKOUT SELL", "{{ticker}} BREAKOUT SELL: the next candle breaks the low in at least the threshold % of past cases")
plot(nBuyNow > 0 ? 100.0 * wBuyNow / nBuyNow : na, "Track: BUY NOW right %", display = display.data_window)
plot(nWaitDip > 0 ? 100.0 * fWaitDip / nWaitDip : na, "Track: BUY AT reached %", display = display.data_window)
plot(nSellNow > 0 ? 100.0 * wSellNow / nSellNow : na, "Track: SELL NOW right %", display = display.data_window)
plot(nWaitUp > 0 ? 100.0 * fWaitUp / nWaitUp : na, "Track: SELL AT reached %", display = display.data_window)
plot(nBuyNow, "Track: BUY NOW calls", display = display.data_window)
plot(nWaitDip, "Track: BUY AT calls", display = display.data_window)
plot(nSellNow, "Track: SELL NOW calls", display = display.data_window)
plot(nWaitUp, "Track: SELL AT calls", display = display.data_window)
