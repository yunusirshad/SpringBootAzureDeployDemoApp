// ════════════════════════════════════════════════════════════════
// ADD-ON · LARGEST POSITIVE GAMMA ABOVE / BELOW (paste at the very bottom
// of "MTF Liquidity Map + Absorption + Orders")
//
// TradingView has no options data, so the gamma by strike is typed in
// from your options / GEX app:  strike=gamma, comma separated, e.g.
//     9=400, 9.5=120, 10=850, 10.5=-300, 11=1200
// Positive gamma = dealers are long gamma there: price tends to slow down,
// stall or pin at that strike.
//   BUY side  · no key level or visible heatmap level left ABOVE the price:
//               the largest positive gamma strike above = SOLID GREEN line.
//   SELL side · no level left BELOW the price: the largest positive gamma
//               strike below = SOLID RED line.
// Each line carries bold dark text on top: LARGEST POSITIVE GAMMA + price.
// NEGATIVE gamma (optional, orange) = dealers are short gamma there: they sell into drops and buy into
//   rallies, so price tends to SPEED UP through that strike (trap door below, squeeze above).
//   The largest negative strike below and above the price are drawn as solid orange lines with
//   LARGEST NEGATIVE GAMMA on top.
// BUY NOW / SELL NOW (closed candles, latest session only, once per level — the gamma list is today's):
//   BUY NOW  · floor held : the candle dips to the largest +gamma BELOW and closes green, back above it
//   BUY NOW  · squeeze    : the candle closes above the largest -gamma ABOVE
//   SELL NOW · ceiling    : the candle tags the largest +gamma ABOVE and closes red, back below it
//   SELL NOW · trap door  : the candle closes below the largest -gamma BELOW
//   Each shows the price, a stop just beyond the level and the next gamma line as the target.
//   Rules from how dealer gamma tends to act, not a backtested edge: confirm with your own read.
// ════════════════════════════════════════════════════════════════
grpGm    = "Largest positive / negative gamma (from your options app)"
gmList   = input.text_area("", "Gamma by strike (strike=gamma, comma separated)", group = grpGm, tooltip = "Paste from your GEX app, e.g.  9=400, 9.5=120, 10=850, 10.5=-300, 11=1200. Positive values give the green / red lines, negative values the orange lines. Update it each morning (open interest changes daily).")
gmMode   = input.string("Always", "Show", ["Always", "Only when no levels on that side"], group = grpGm)
gmRange  = input.float(15.0, "Look within (% from price)", 0.5, 100.0, 0.5, group = grpGm)
gmBelow  = input.bool(true, "Also the sell side (below the price)", group = grpGm)
gmColUp  = input.color(#00e676, "Line above (buy side)", group = grpGm)
gmColDn  = input.color(#ff1744, "Line below (sell side)", group = grpGm)
gmNeg    = input.bool(true, "Also the largest NEGATIVE gamma (below and above)", group = grpGm)
gmColNeg = input.color(#ff9800, "Line negative gamma", group = grpGm)
gmTxtCol = input.color(color.black, "Text color", group = grpGm)
gmWidth  = input.int(3, "Line width", 1, 6, group = grpGm)
gmSig    = input.bool(true, "BUY NOW / SELL NOW signals at the gamma lines", group = grpGm)
gmTouch  = input.float(0.3, "Touch = within (% of the level)", 0.0, 5.0, 0.05, group = grpGm)
gmStopP  = input.float(0.5, "Stop beyond the level (%)", 0.05, 10.0, 0.05, group = grpGm)

// the strike with the largest positive gamma above (dir 1) or below (dir -1) the price, within the range
gmBest(string list, int dir, float px, float rngPct, int sgn = 1) =>
    float bestK = na
    float bestG = na
    for item in str.split(list, ",")
        array<string> parts = str.split(str.trim(item), "=")
        if parts.size() == 2
            float strike = str.tonumber(str.trim(parts.get(0)))
            float g      = str.tonumber(str.trim(parts.get(1)))
            bool inRange = dir == 1 ? strike > px and strike <= px * (1 + rngPct / 100) : strike < px and strike >= px * (1 - rngPct / 100)
            if not na(strike) and not na(g) and g * sgn > 0 and inRange
                if na(bestG) or g * sgn > bestG * sgn
                    bestK := strike
                    bestG := g
    [bestK, bestG]

var line  gmLineUp = na
var label gmTxtUp  = na
var line  gmLineDn = na
var label gmTxtDn  = na
var line  gmLineNb = na
var label gmTxtNb  = na
var line  gmLineNa = na
var label gmTxtNa  = na
float gmNegBelow = na
float gmNegAbove = na
float gmUp = na
float gmDn = na
if barstate.islast
    gmLineUp.delete(), gmTxtUp.delete(), gmLineDn.delete(), gmTxtDn.delete()
    gmLineNb.delete(), gmTxtNb.delete(), gmLineNa.delete(), gmTxtNa.delete()
    // is any liquidity still left above / below the price?
    bool anyAbove = false
    bool anyBelow = false
    for k in keys
        if not na(k.price) and not k.taken
            anyAbove := anyAbove or k.price > close
            anyBelow := anyBelow or k.price < close
    for l in levels
        if not isWeak(l)
            anyAbove := anyAbove or l.price > close
            anyBelow := anyBelow or l.price < close
    int gmX = time + zoneLblOff * ms
    if gmMode == "Always" or not anyAbove
        [kU, gU] = gmBest(gmList, 1, close, gmRange)
        if not na(kU)
            gmUp := kU
            gmLineUp := line.new(bar_index - 1, kU, bar_index, kU, extend = extend.both, color = gmColUp, width = gmWidth, style = line.style_solid)
            gmTxtUp  := label.new(gmX, kU, "LARGEST POSITIVE GAMMA  " + str.tostring(kU, format.mintick) + "  (+" + str.tostring(gU, format.volume) + ")", xloc = xloc.bar_time, style = label.style_label_down, color = color.new(color.black, 100), textcolor = gmTxtCol, size = lblSz, text_formatting = text.format_bold)
    if gmBelow and (gmMode == "Always" or not anyBelow)
        [kD, gD] = gmBest(gmList, -1, close, gmRange)
        if not na(kD)
            gmDn := kD
            gmLineDn := line.new(bar_index - 1, kD, bar_index, kD, extend = extend.both, color = gmColDn, width = gmWidth, style = line.style_solid)
            gmTxtDn  := label.new(gmX, kD, "LARGEST POSITIVE GAMMA  " + str.tostring(kD, format.mintick) + "  (+" + str.tostring(gD, format.volume) + ")", xloc = xloc.bar_time, style = label.style_label_down, color = color.new(color.black, 100), textcolor = gmTxtCol, size = lblSz, text_formatting = text.format_bold)

    if gmNeg
        [nB, ngB] = gmBest(gmList, -1, close, gmRange, -1)
        if not na(nB)
            gmNegBelow := nB
            gmLineNb := line.new(bar_index - 1, nB, bar_index, nB, extend = extend.both, color = gmColNeg, width = gmWidth, style = line.style_solid)
            gmTxtNb  := label.new(gmX, nB, "LARGEST NEGATIVE GAMMA  " + str.tostring(nB, format.mintick) + "  (" + str.tostring(ngB, format.volume) + ")  · drops can speed up", xloc = xloc.bar_time, style = label.style_label_down, color = color.new(color.black, 100), textcolor = gmTxtCol, size = lblSz, text_formatting = text.format_bold)
        [nA, ngA] = gmBest(gmList, 1, close, gmRange, -1)
        if not na(nA)
            gmNegAbove := nA
            gmLineNa := line.new(bar_index - 1, nA, bar_index, nA, extend = extend.both, color = gmColNeg, width = gmWidth, style = line.style_solid)
            gmTxtNa  := label.new(gmX, nA, "LARGEST NEGATIVE GAMMA  " + str.tostring(nA, format.mintick) + "  (" + str.tostring(ngA, format.volume) + ")  · breakouts can squeeze", xloc = xloc.bar_time, style = label.style_label_down, color = color.new(color.black, 100), textcolor = gmTxtCol, size = lblSz, text_formatting = text.format_bold)

plot(gmUp, "Largest +gamma above", display = display.data_window)
plot(gmDn, "Largest +gamma below", display = display.data_window)
alertcondition(not na(gmUp) and high >= gmUp * 0.995, "Near the largest +gamma above", "{{ticker}} is near the largest positive gamma strike above ({{close}})")
alertcondition(not na(gmDn) and low <= gmDn * 1.005, "Near the largest +gamma below", "{{ticker}} is near the largest positive gamma strike below ({{close}})")
plot(gmNegBelow, "Largest -gamma below", display = display.data_window)
plot(gmNegAbove, "Largest -gamma above", display = display.data_window)
alertcondition(not na(gmNegBelow) and low <= gmNegBelow * 1.005, "Near the largest -gamma below", "{{ticker}} is at the largest negative gamma strike below: drops can speed up ({{close}})")
alertcondition(not na(gmNegAbove) and high >= gmNegAbove * 0.995, "Near the largest -gamma above", "{{ticker}} is at the largest negative gamma strike above: a breakout can squeeze ({{close}})")

// ─── BUY NOW / SELL NOW at the gamma lines ──────────────────────
// levels as they stood at the previous close, so a crossing is measured against the right line
[sPosUp, sPosUpG] = gmBest(gmList, 1, close[1], gmRange)
[sPosDn, sPosDnG] = gmBest(gmList, -1, close[1], gmRange)
[sNegDn, sNegDnG] = gmBest(gmList, -1, close[1], gmRange, -1)
[sNegUp, sNegUpG] = gmBest(gmList, 1, close[1], gmRange, -1)
bool gmToday = timeframe.isintraday and year(time) == year(last_bar_time) and month(time) == month(last_bar_time) and dayofmonth(time) == dayofmonth(last_bar_time)
var float gmFiredBuy = na
var float gmFiredSell = na
var array<label> gmSigLbls = array.new<label>()
if ta.change(time("D")) != 0
    gmFiredBuy := na
    gmFiredSell := na
float tch = gmTouch / 100
bool bFloor = not na(sPosDn) and low <= sPosDn * (1 + tch) and close > sPosDn and close > open
bool bSqz   = not na(sNegUp) and close > sNegUp and close[1] <= sNegUp
bool sCeil  = not na(sPosUp) and high >= sPosUp * (1 - tch) and close < sPosUp and close < open
bool sTrap  = not na(sNegDn) and close < sNegDn and close[1] >= sNegDn
float bLvl = bFloor ? sPosDn : bSqz ? sNegUp : na
float sLvl = sCeil ? sPosUp : sTrap ? sNegDn : na
bool gmBuyNow  = gmSig and gmToday and barstate.isconfirmed and not na(bLvl) and bLvl != nz(gmFiredBuy)
bool gmSellNow = gmSig and gmToday and barstate.isconfirmed and not na(sLvl) and sLvl != nz(gmFiredSell)
// next gamma line beyond the price, as the target
nextAbove(float px) =>
    float t1 = not na(sPosUp) and sPosUp > px ? sPosUp : na
    float t2 = not na(sNegUp) and sNegUp > px ? sNegUp : na
    na(t1) ? t2 : na(t2) ? t1 : math.min(t1, t2)
nextBelow(float px) =>
    float t1 = not na(sPosDn) and sPosDn < px ? sPosDn : na
    float t2 = not na(sNegDn) and sNegDn < px ? sNegDn : na
    na(t1) ? t2 : na(t2) ? t1 : math.max(t1, t2)
if gmBuyNow
    gmFiredBuy := bLvl
    float st = bLvl * (1 - gmStopP / 100)
    float tg = nextAbove(close)
    string why = bFloor ? "floor held at +gamma " : "squeeze through -gamma "
    gmSigLbls.push(label.new(bar_index, low, "BUY NOW " + str.tostring(close, format.mintick) + "\n" + why + str.tostring(bLvl, format.mintick) + "\nstop " + str.tostring(st, format.mintick) + (na(tg) ? "" : " · target " + str.tostring(tg, format.mintick)), style = label.style_label_up, color = #089981, textcolor = color.white, size = size.small, text_formatting = text.format_bold))
if gmSellNow
    gmFiredSell := sLvl
    float st = sLvl * (1 + gmStopP / 100)
    float tg = nextBelow(close)
    string why = sCeil ? "ceiling at +gamma " : "trap door through -gamma "
    gmSigLbls.push(label.new(bar_index, high, "SELL NOW " + str.tostring(close, format.mintick) + "\n" + why + str.tostring(sLvl, format.mintick) + "\nstop " + str.tostring(st, format.mintick) + (na(tg) ? "" : " · target " + str.tostring(tg, format.mintick)), style = label.style_label_down, color = #f23645, textcolor = color.white, size = size.small, text_formatting = text.format_bold))
if gmSigLbls.size() > 30
    gmSigLbls.shift().delete()
plot(gmBuyNow ? 1 : 0, "Gamma BUY NOW", display = display.data_window)
plot(gmSellNow ? 1 : 0, "Gamma SELL NOW", display = display.data_window)
alertcondition(gmBuyNow, "Gamma BUY NOW", "{{ticker}} BUY NOW at a gamma line ({{close}}): floor held or squeeze")
alertcondition(gmSellNow, "Gamma SELL NOW", "{{ticker}} SELL NOW at a gamma line ({{close}}): ceiling or trap door")
